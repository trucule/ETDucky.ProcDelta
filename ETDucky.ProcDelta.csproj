<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>ETDucky.ProcDelta</AssemblyName>
    <RootNamespace>ETDucky.ProcDelta</RootNamespace>
    <!-- The test project lives under tests\ inside this folder. Without this
         the default **/*.cs glob would compile the xunit sources into the app. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <!-- Embedded PDB: the crash log and the fatal-error dialog carry line
         numbers in the field, at the cost of a slightly larger exe. The
         source is public, so the embedded paths reveal nothing. -->
    <DebugType>embedded</DebugType>
    <!-- Keep the build clean while the project is small enough to do so.
         NuGet audit advisories (NU1901-NU1904) stay warnings: a transitive
         advisory should not break every build from source; Dependabot alerts
         on the repository carry them instead. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- Pin the analyzer level so CI (which checks out only this repository)
         enforces the same rules as a local build inside the desktop tree,
         whose Directory.Build.props raises the analysis level. -->
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Single-file publish: managed assemblies load from the bundle in
         memory and nothing is written to %TEMP%. Native libraries are NOT
         bundled for self-extraction: the tool runs elevated, and the
         default extraction directory (%TEMP%\.net\<app>\<bundle-id>) is
         writable by non-elevated processes of the same user, so a planted
         DLL there would load into an admin process. The runtime natives
         this leaves beside the exe in the publish folder (DiaSymReader,
         DAC, createdump) are debugging aids and are not needed to run;
         the portable release ships the exe alone. The TraceEvent native
         shims copied by the target below are build-output files, not
         publish items, and were never inside the bundle. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>

    <!-- packages.lock.json pins every resolved package and its hash. CI
         restores in locked mode, so a dependency that resolves differently
         from the committed lock file fails the build instead of shipping.
         Update the lock file by running a normal `dotnet restore` here and
         committing the result. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ETDucky.ProcDelta.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same TraceEvent version as ProviderExplorer / the agent so the
         native shims stay binary-compatible if both tools are on a host. -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.6" GeneratePathProperty="true" />

    <!-- Note: Microsoft.Win32.Registry and System.Security.AccessControl are
         part of the .NET 10 Windows runtime targeting pack — no explicit
         PackageReferences needed. Adding them produces NU1510 warnings. -->
  </ItemGroup>

  <!-- Embed app.ico as a managed resource in addition to the PE
       IDI_APPLICATION resource set by <ApplicationIcon>. The PE resource
       drives the Explorer file icon; this embedded copy is what MainForm
       loads at runtime to set Form.Icon (taskbar + title bar + Alt+Tab).
       Required because Assembly.GetExecutingAssembly().Location returns
       empty in single-file published builds, breaking ExtractAssociatedIcon. -->
  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <!-- Note: this project does NOT reference ETDucky.Core. It is built to stand
       alone in its own public Apache 2.0-licensed repo, with no agent-internal
       types in its surface area. -->

  <!-- TraceEvent native DLL copy — same mechanism as ProviderExplorer. -->
  <Target Name="CopyTraceEventNativeDLLs" AfterTargets="Build">
    <ItemGroup>
      <TraceEventX64DLLs Include="$(PkgMicrosoft_Diagnostics_Tracing_TraceEvent)\build\native\amd64\*.dll" Condition="Exists('$(PkgMicrosoft_Diagnostics_Tracing_TraceEvent)\build\native\amd64')" />
      <TraceEventX64DLLs Include="$(PkgMicrosoft_Diagnostics_Tracing_TraceEvent)\build\native\x64\*.dll" Condition="Exists('$(PkgMicrosoft_Diagnostics_Tracing_TraceEvent)\build\native\x64')" />
    </ItemGroup>
    <Copy SourceFiles="@(TraceEventX64DLLs)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'@(TraceEventX64DLLs)' != ''" />
  </Target>
</Project>
